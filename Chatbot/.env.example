# TEMPLATE — safe to commit. Never put a real key in this file.
#
# Local dev:  copy to `Chatbot/.env` and fill in the real key there (.env is
#             gitignored). Run the site with `netlify dev`.
# Production: set these in Netlify → Site configuration → Environment variables.
#             Netlify does not read this file.
#
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME

# Optional. Any OpenRouter model id. Leave unset to use the built-in fallback
# chain in netlify/functions/chat.mjs, which tries several ":free" models in
# order — free models are frequently rate-limited, and the chain rides that out.
# Setting this pins one model and disables the fallback.
# CHAT_MODEL=nvidia/nemotron-3-nano-30b-a3b:free
